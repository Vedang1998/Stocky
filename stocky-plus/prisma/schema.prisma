generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Shopify session storage (required by template) ─────────────────────────
// Session remains a restricted bootstrap/session-storage exception in Phase 1
// PR 1. Schema must stay compatible with Shopify's Prisma session-storage
// adapter. Do not add shopId here.

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

// ─── Canonical Shop (Phase 1 PR 1) ───────────────────────────────────────────
// Minimal tenant identity only. Billing/plan/entitlement/privacy fields are
// deferred. Database-enforced shopId NOT NULL, composite FKs, and RLS are
// applied by PR 3 external enforcement tooling (not Prisma Migrate alone).
// Prisma keeps shopId optional for expand/migrate compatibility; the live DB
// must have NOT NULL after tenant:enforcement:apply.

enum ShopProcessingDisabledReason {
  UNINSTALLED
  MANUAL
  REDACTED
}

model Shop {
  id                        String                         @id @default(cuid())
  myshopifyDomain           String                         @unique
  processingEnabled         Boolean                        @default(true)
  processingDisabledReason  ShopProcessingDisabledReason?
  processingDisabledAt      DateTime?
  uninstalledAt             DateTime?
  reinstalledAt             DateTime?
  createdAt                 DateTime                       @default(now())
  updatedAt                 DateTime                       @updatedAt

  webhookDeliveries   WebhookDelivery[]
  durableJobs         DurableJob[]
  jobAttempts         JobAttempt[]
  jobDispatches       JobDispatch[]
  deadLetters         DeadLetter[]
  jobReplays          JobReplay[]
  syncRuns            SyncRun[]
  syncCursors         SyncCursor[]
  reconciliationRuns  ReconciliationRun[]
  dataIssues          DataIssue[]
  syncHealth          SyncHealth[]
  syncApplicationReceipts SyncApplicationReceipt[]
  dispatchReadyShop   DispatchReadyShop?
  shopifyProductFacts ShopifyProductFact[]
  shopifyVariantFacts ShopifyVariantFact[]
  shopifyInventoryItemFacts ShopifyInventoryItemFact[]
  shopifyLocationFacts ShopifyLocationFact[]
  shopifyInventoryLevelFacts ShopifyInventoryLevelFact[]
  catalogObservationsInFlight CatalogObservationInFlight[]
  shopifyProductCollectionMemberships ShopifyProductCollectionMembership[]
}

/// Per-shop dispatch readiness / fairness cursor (D-048 / D-049 / D-050).
/// Exactly one row per shop with PENDING/RETRY_WAIT work (including future-due),
/// plus fail-safe false-positive rows reconciled at claim time via D-050
/// fresh-snapshot reconciliation (scheduler lock → candidates → lease → reconcile).
/// Selection is indexed on nextDispatchAt — never scans Shop / never sorts the
/// full active-due population (D-049 / F-D048-03).
model DispatchReadyShop {
  shopId             String   @id
  /// Monotonic earliest-eligible hint (LEAST on arrival; may be stale-early).
  earliestEligibleAt DateTime
  /// Persisted scheduling key: WHERE nextDispatchAt <= now ORDER BY nextDispatchAt, shopId.
  nextDispatchAt     DateTime
  lastServedAt       DateTime?
  /// Denormalized from Shop so claim SQL never Seq Scans Shop (D-048 / R12).
  processingEnabled  Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Restrict)

  @@index([processingEnabled, nextDispatchAt, shopId], map: "DispatchReadyShop_dispatch_schedule_idx")
}

// ─── Tenant backfill control (Phase 1 PR 1) ──────────────────────────────────
// Migration/diagnostic infrastructure — not merchant-facing runtime tables.

enum TenantBackfillMode {
  DRY_RUN
  APPLY
}

enum TenantBackfillRunStatus {
  PENDING
  RUNNING
  COMPLETED
  COMPLETED_WITH_ISSUES
  FAILED
}

enum TenantBackfillCheckpointStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum TenantOwnershipIssueStatus {
  OPEN
  RESOLVED
}

model TenantBackfillRun {
  id                    String                 @id @default(cuid())
  normalizationVersion  String
  mode                  TenantBackfillMode
  status                TenantBackfillRunStatus @default(PENDING)
  batchSize             Int
  startedAt             DateTime?
  completedAt           DateTime?
  failedAt              DateTime?
  sourceMainSha         String?
  schemaVersion         String?
  beforeCounts          Json?
  examinedCounts        Json?
  updatedCounts         Json?
  unchangedCounts       Json?
  unresolvedCounts      Json?
  checksums             Json?
  failureSummary        String?
  resumeMetadata        Json?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  checkpoints TenantBackfillCheckpoint[]
  issuesFirst TenantOwnershipIssue[]     @relation("IssueFirstDetectedRun")
  issuesLast  TenantOwnershipIssue[]     @relation("IssueLastDetectedRun")
  issueDetections TenantOwnershipIssueDetection[]

  @@index([status, createdAt])
}

model TenantBackfillCheckpoint {
  id              String                        @id @default(cuid())
  runId           String
  tableName       String
  lastProcessedId String?
  examinedCount   Int                           @default(0)
  updatedCount    Int                           @default(0)
  unchangedCount  Int                           @default(0)
  unresolvedCount Int                           @default(0)
  checksum        String?
  status          TenantBackfillCheckpointStatus @default(PENDING)
  updatedAt       DateTime                      @updatedAt
  createdAt       DateTime                      @default(now())

  run TenantBackfillRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, tableName])
  @@index([tableName, status])
}

model TenantOwnershipIssue {
  id                         String                     @id @default(cuid())
  fingerprint                String                     @unique
  firstDetectedRunId         String
  lastDetectedRunId          String
  tableName                  String
  rowId                      String
  reasonCode                 String
  currentOwnershipEvidence   Json?
  conflictingOwnershipEvidence Json?
  parentLineage              Json?
  sourceShopValues           Json?
  proposedCanonicalShop      String?
  status                     TenantOwnershipIssueStatus @default(OPEN)
  resolutionEvidence         Json?
  reopenedAt                 DateTime?
  reopenCount                Int                        @default(0)
  firstDetectedAt            DateTime                   @default(now())
  lastDetectedAt             DateTime                   @default(now())

  firstDetectedRun TenantBackfillRun @relation("IssueFirstDetectedRun", fields: [firstDetectedRunId], references: [id])
  lastDetectedRun  TenantBackfillRun @relation("IssueLastDetectedRun", fields: [lastDetectedRunId], references: [id])
  detections       TenantOwnershipIssueDetection[]

  @@index([tableName, status])
  @@index([reasonCode, status])
  @@index([rowId, tableName])
}

/**
 * Immutable per-run detection history for ownership issues (R6).
 * Historical metrics for run A must remain stable after run B redetects the same fingerprint.
 * currentRunDetectedIssueCount / currentRunOpenIssueCount are derived from these rows,
 * not from mutable lastDetectedRunId. blockingIssueCount = current global OPEN issues.
 */
model TenantOwnershipIssueDetection {
  id                    String                     @id @default(cuid())
  runId                 String
  ownershipIssueId      String
  fingerprint           String
  detectedStatus        TenantOwnershipIssueStatus
  tableName             String
  rowId                 String
  reasonCode            String
  detectedAt            DateTime                   @default(now())
  wasOpenAfterDetection Boolean
  reopenedIssue         Boolean                    @default(false)

  run   TenantBackfillRun    @relation(fields: [runId], references: [id], onDelete: Cascade)
  issue TenantOwnershipIssue @relation(fields: [ownershipIssueId], references: [id], onDelete: Cascade)

  @@unique([runId, fingerprint])
  @@index([runId, detectedAt])
  @@index([ownershipIssueId])
  @@index([tableName, reasonCode])
}

// ─── Module 1: Advanced Supplier Master ─────────────────────────────────────

model Supplier {
  id            String   @id @default(cuid())
  shop          String
  shopId        String?
  name          String
  accountNumber String?
  contactName   String?
  contactEmail  String?
  contactPhone  String?
  currency      String   @default("USD")
  vendorNotes   String?
  leadTimeDays  Float?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  skuMappings       SupplierSkuMapping[]
  volumeTiers       VolumePriceTier[]
  purchaseOrders    PurchaseOrder[]
  leadTimeSnapshots LeadTimeSnapshot[]

  @@index([shop])
  @@index([shopId])
  @@unique([shopId, id])
}

model SupplierSkuMapping {
  id               String  @id @default(cuid())
  shopId           String?
  supplierId       String
  shopifyVariantId String
  vendorSku        String
  moq              Int     @default(1)
  packSize         Int     @default(1)

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([supplierId, shopifyVariantId])
  @@index([shopifyVariantId])
  @@index([shopId])
  @@index([shopId, supplierId])
  @@unique([shopId, id])
}

model VolumePriceTier {
  id         String  @id @default(cuid())
  shopId     String?
  supplierId String
  variantId  String
  minQty     Int
  maxQty     Int?
  unitCost   Decimal @db.Decimal(10, 4)

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([supplierId, variantId])
  @@index([shopId])
  @@index([shopId, supplierId])
  @@unique([shopId, id])
}

model LeadTimeSnapshot {
  id              String   @id @default(cuid())
  shopId          String?
  supplierId      String
  purchaseOrderId String   @unique
  leadTimeDays    Float
  recordedAt      DateTime @default(now())

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([shopId])
  @@index([shopId, supplierId])
  @@index([shopId, purchaseOrderId])
  @@unique([shopId, id])
}

// ─── Module 2: Purchase Order Engine ────────────────────────────────────────

enum POStatus {
  DRAFT
  ORDERED
  PARTIAL
  RECEIVED
  CANCELLED
}

enum LandedCostMethod {
  WEIGHT
  VOLUME
  COST
}

model PurchaseOrder {
  id               String           @id @default(cuid())
  shop             String
  shopId           String?
  supplierId       String
  locationId       String
  poNumber         String?
  status           POStatus         @default(DRAFT)
  currency         String           @default("USD")
  exchangeRate     Decimal?         @db.Decimal(10, 6)
  freightCost      Decimal?         @db.Decimal(10, 2)
  customsCost      Decimal?         @db.Decimal(10, 2)
  landedCostMethod LandedCostMethod @default(COST)
  notes            String?
  draftedAt        DateTime?
  orderedAt        DateTime?
  fullyReceivedAt  DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  supplier  Supplier     @relation(fields: [supplierId], references: [id])
  lineItems POLineItem[]

  @@index([shop, status])
  @@index([supplierId])
  @@index([shopId])
  @@index([shopId, supplierId])
  @@unique([shopId, id])
}

model POLineItem {
  id                  String   @id @default(cuid())
  shopId              String?
  purchaseOrderId     String
  shopifyVariantId    String
  vendorSku           String?
  orderedQty          Int
  receivedQty         Int      @default(0)
  unitCost            Decimal  @db.Decimal(10, 4)
  manualCostOverride  Boolean  @default(false)
  weight              Decimal? @db.Decimal(10, 4)
  volume              Decimal? @db.Decimal(10, 4)
  allocatedLandedCost Decimal? @db.Decimal(10, 4)
  retailPrice         Decimal? @db.Decimal(10, 2)

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@index([purchaseOrderId])
  @@index([shopifyVariantId])
  @@index([shopId])
  @@index([shopId, purchaseOrderId])
  @@unique([shopId, id])
}

// ─── Shopify data cache ─────────────────────────────────────────────────────

model ShopifyVariantCache {
  id               String   @id @default(cuid())
  shop             String
  shopId           String?
  shopifyVariantId String
  shopifyProductId String?
  title            String
  sku              String?
  barcode          String?
  imageUrl         String?
  inventoryItemId  String?
  weight           Decimal? @db.Decimal(10, 4)
  weightUnit       String?
  updatedAt        DateTime @updatedAt

  @@unique([shop, shopifyVariantId])
  @@index([shop, barcode])
  @@index([shopId])
  @@unique([shopId, id])
}

model InventorySnapshot {
  id                String   @id @default(cuid())
  shop              String
  shopId            String?
  shopifyVariantId  String
  locationId        String
  quantityAvailable Int
  snapshotDate      DateTime @db.Date

  @@unique([shop, shopifyVariantId, locationId, snapshotDate])
  @@index([shop, snapshotDate])
  @@index([shopId])
  @@unique([shopId, id])
}

// ─── Module 3: Forecasting & ABC ────────────────────────────────────────────

enum AbcClass {
  A
  B
  C
}

enum AbcMetric {
  REVENUE
  VOLUME
}

model VariantAbcClass {
  id               String    @id @default(cuid())
  shop             String
  shopId           String?
  shopifyVariantId String
  locationId       String    @default("all")
  abcClass         AbcClass
  metric           AbcMetric @default(REVENUE)
  revenue          Decimal   @db.Decimal(12, 2) @default(0)
  unitsSold        Int       @default(0)
  calculatedAt     DateTime  @default(now())

  @@unique([shop, shopifyVariantId, locationId, metric])
  @@index([shopId])
  @@unique([shopId, id])
}

model ForecastOverride {
  id            String   @id @default(cuid())
  shop          String
  shopId        String?
  variantId     String
  locationId    String
  lookbackStart DateTime
  lookbackEnd   DateTime

  @@unique([shop, variantId, locationId])
  @@index([shopId])
  @@unique([shopId, id])
}

model SalesDailyAggregate {
  id               String   @id @default(cuid())
  shop             String
  shopId           String?
  shopifyVariantId String
  locationId       String
  date             DateTime @db.Date
  unitsSold        Int      @default(0)
  revenue          Decimal  @db.Decimal(12, 2) @default(0)

  @@unique([shop, shopifyVariantId, locationId, date])
  @@index([shop, date])
  @@index([shopId])
  @@unique([shopId, id])
}

model ShopSettings {
  id                  String    @id @default(cuid())
  shop                String    @unique
  shopId              String?
  defaultLookbackDays Int       @default(30)
  targetDaysOfStock   Int       @default(14)
  defaultSafetyStock  Int       @default(0)
  abcMetric           AbcMetric @default(REVENUE)
  subscriptionActive  Boolean   @default(false)
  subscriptionPlan    String?

  @@index([shopId])
  @@unique([shopId, id])
}

// ─── Module 5: Transfer Orders ────────────────────────────────────────────────

enum TransferStatus {
  DRAFT
  IN_TRANSIT
  RECEIVED
  CANCELLED
}

model TransferOrder {
  id                    String         @id @default(cuid())
  shop                  String
  shopId                String?
  sourceLocationId      String
  destinationLocationId String
  status                TransferStatus @default(DRAFT)
  shopifyTransferId     String?
  notes                 String?
  shippedAt             DateTime?
  receivedAt            DateTime?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  lineItems TransferLineItem[]

  @@index([shop, status])
  @@index([shopId])
  @@unique([shopId, id])
}

model TransferLineItem {
  id               String  @id @default(cuid())
  shopId           String?
  transferOrderId  String
  shopifyVariantId String
  quantity         Int
  pickedQty        Int     @default(0)
  receivedQty      Int     @default(0)

  transferOrder TransferOrder @relation(fields: [transferOrderId], references: [id], onDelete: Cascade)

  @@index([shopId])
  @@index([shopId, transferOrderId])
  @@unique([shopId, id])
}

// ─── Module 4: Stocktakes ─────────────────────────────────────────────────────

enum StocktakeStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Stocktake {
  id          String          @id @default(cuid())
  shop        String
  shopId      String?
  locationId  String
  status      StocktakeStatus @default(DRAFT)
  name        String
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime        @default(now())

  lineItems StocktakeLineItem[]

  @@index([shopId])
  @@unique([shopId, id])
}

model StocktakeLineItem {
  id               String  @id @default(cuid())
  shopId           String?
  stocktakeId      String
  shopifyVariantId String
  expectedQty      Int
  countedQty       Int?

  stocktake Stocktake @relation(fields: [stocktakeId], references: [id], onDelete: Cascade)

  @@index([shopId])
  @@index([shopId, stocktakeId])
  @@unique([shopId, id])
}

// ─── Module 9: Bill of Materials ──────────────────────────────────────────────

model BomComponent {
  id                 String  @id @default(cuid())
  shop               String
  shopId             String?
  bundleVariantId    String
  componentVariantId String
  quantity           Decimal @db.Decimal(10, 4)

  @@unique([shop, bundleVariantId, componentVariantId])
  @@index([shopId])
  @@unique([shopId, id])
}

// ─── Module 6: Alerts ─────────────────────────────────────────────────────────

model LowStockAlert {
  id               String   @id @default(cuid())
  shop             String
  shopId           String?
  shopifyVariantId String
  locationId       String
  reorderPoint     Int
  currentStock     Int
  acknowledged     Boolean  @default(false)
  createdAt        DateTime @default(now())

  @@index([shop, acknowledged])
  @@index([shopId])
  @@unique([shopId, id])
}

// ─── Phase 1 PR 4: Synchronization control plane ─────────────────────────────
// Classification: platform_control_plane (tenant-owned via non-null shopId).
// Not merchant-domain FORCE RLS — dispatcher requires cross-shop SKIP LOCKED.
// Runtime role receives no DML grants on these tables.

enum WebhookDeliveryState {
  RECEIVED
  JOB_CREATED
  COMPLETED
  FAILED
  CONFLICT
  QUARANTINED
}

enum DurableJobState {
  PENDING
  DISPATCH_LEASED
  ENQUEUED
  RUNNING
  RETRY_WAIT
  SUCCEEDED
  FAILED
  DEAD_LETTERED
  CANCELLED
}

enum JobAttemptOutcome {
  SUCCEEDED
  RETRYABLE_FAILURE
  NON_RETRYABLE_FAILURE
  CANCELLED
  DENIED
  ABANDONED
  LEASE_EXPIRED
  WORKER_LOST
}

enum JobDispatchState {
  PENDING_ENQUEUE
  ENQUEUED
  OBSERVED
  STARTED
  COMPLETED
  FAILED
  SUPERSEDED
}

enum JobExecutionStrategy {
  ATOMIC_APPLICATION_RECEIPT
  REBUILDABLE_IDEMPOTENT
  NO_AUTOMATIC_RETRY
  CONTROL_ONLY
}

enum DeadLetterResolutionState {
  OPEN
  REPLAYED
  DISMISSED
  SUPERSEDED
}

enum SyncRunStatus {
  PENDING
  RUNNING
  SUCCEEDED
  PARTIAL_FAILURE
  FAILED
  CANCELLED
}

enum SyncHealthState {
  NEVER_STARTED
  RUNNING
  HEALTHY
  DEGRADED
  FAILED
  DISABLED
}

enum DataIssueSeverity {
  INFO
  WARNING
  ERROR
  CRITICAL
}

enum DataIssueStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
  WONT_FIX
}

model WebhookDelivery {
  id                        String               @id @default(cuid())
  shopId                    String
  /// Null when Shopify omits X-Shopify-Webhook-Id — quarantine only; never idempotent.
  shopifyWebhookId          String?
  topic                     String               @db.VarChar(128)
  apiVersionReceived        String               @db.VarChar(32)
  receivedAt                DateTime             @default(now())
  payloadSchemaVersion      String               @db.VarChar(64)
  sanitizedPayload          Json
  payloadDigest             String               @db.VarChar(64)
  correlationId             String
  duplicateCount            Int                  @default(0)
  payloadDigestMismatchCount Int                 @default(0)
  lastConflictingDigest     String?              @db.VarChar(64)
  firstMismatchAt           DateTime?
  lastMismatchAt            DateTime?
  quarantineReason          String?              @db.VarChar(128)
  firstSeenAt               DateTime             @default(now())
  lastSeenAt                DateTime             @default(now())
  state                     WebhookDeliveryState @default(RECEIVED)
  durableJobId              String?
  completedAt               DateTime?
  failedAt                  DateTime?
  failureCode               String?              @db.VarChar(64)
  failureSummary            String?              @db.VarChar(512)
  createdAt                 DateTime             @default(now())
  updatedAt                 DateTime             @updatedAt

  shop       Shop        @relation(fields: [shopId], references: [id], onDelete: Restrict)
  durableJob DurableJob? @relation(fields: [durableJobId], references: [id], onDelete: SetNull)

  @@unique([shopId, id])
  @@index([shopId, state, receivedAt])
  @@index([shopId, topic, receivedAt])
}

model DurableJob {
  id                     String                @id @default(cuid())
  shopId                 String
  jobType                String                @db.VarChar(128)
  source                 String                @db.VarChar(128)
  queueName              String                @db.VarChar(64)
  payloadSchemaVersion   String                @db.VarChar(64)
  sanitizedPayload       Json
  payloadDigest          String                @db.VarChar(64)
  idempotencyKey         String                @db.VarChar(256)
  correlationId          String
  causationId            String?
  authorityVersion       String                @db.VarChar(64)
  executionStrategy      JobExecutionStrategy  @default(ATOMIC_APPLICATION_RECEIPT)
  state                  DurableJobState       @default(PENDING)
  attemptCount           Int                   @default(0)
  maxAttempts            Int                   @default(3)
  nextEligibleAt         DateTime              @default(now())
  leaseOwner             String?               @db.VarChar(128)
  leaseExpiresAt         DateTime?
  activeDispatchSequence Int?
  enqueuedAt             DateTime?
  startedAt              DateTime?
  completedAt            DateTime?
  cancelledAt            DateTime?
  deadLetteredAt         DateTime?
  failureCode            String?               @db.VarChar(64)
  failureSummary         String?               @db.VarChar(512)
  webhookDeliveryId      String?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  shop              Shop              @relation(fields: [shopId], references: [id], onDelete: Restrict)
  attempts          JobAttempt[]
  dispatches        JobDispatch[]
  deadLetters       DeadLetter[]
  replaysAsOriginal JobReplay[]       @relation("ReplayOriginalJob")
  replaysAsNew      JobReplay[]       @relation("ReplayNewJob")
  webhookDeliveries WebhookDelivery[]

  @@unique([shopId, idempotencyKey])
  @@unique([shopId, id])
  @@index([state, nextEligibleAt, createdAt])
  @@index([shopId, state, nextEligibleAt])
  @@index([shopId, jobType, createdAt])
  @@index([leaseExpiresAt])
}

model JobDispatch {
  id               String          @id @default(cuid())
  shopId           String
  durableJobId     String
  dispatchSequence Int
  queueName        String          @db.VarChar(64)
  queueJobId       String          @db.VarChar(256)
  state            JobDispatchState @default(PENDING_ENQUEUE)
  leaseOwner       String?         @db.VarChar(128)
  leaseExpiresAt   DateTime?
  createdAt        DateTime        @default(now())
  enqueuedAt       DateTime?
  observedAt       DateTime?
  startedAt        DateTime?
  completedAt      DateTime?
  failureCode      String?         @db.VarChar(64)
  failureSummary   String?         @db.VarChar(512)
  payloadDigest    String          @db.VarChar(64)
  updatedAt        DateTime        @updatedAt

  shop       Shop         @relation(fields: [shopId], references: [id], onDelete: Restrict)
  durableJob DurableJob   @relation(fields: [durableJobId], references: [id], onDelete: Restrict)
  attempts   JobAttempt[]

  @@unique([durableJobId, dispatchSequence])
  @@unique([queueName, queueJobId])
  @@unique([shopId, id])
  @@index([shopId, durableJobId, createdAt])
  @@index([state, leaseExpiresAt])
}

model JobAttempt {
  id                  String             @id @default(cuid())
  shopId              String
  durableJobId        String
  attemptNumber       Int
  workerId            String             @db.VarChar(128)
  jobDispatchId       String?
  leaseOwner          String?            @db.VarChar(128)
  leaseExpiresAt      DateTime?
  heartbeatAt         DateTime?
  startedAt           DateTime           @default(now())
  finishedAt          DateTime?
  outcome             JobAttemptOutcome?
  retryClassification String?            @db.VarChar(64)
  backoffMs           Int?
  errorCode           String?            @db.VarChar(64)
  failureSummary      String?            @db.VarChar(512)
  resultMetadata      Json?
  createdAt           DateTime           @default(now())

  shop       Shop         @relation(fields: [shopId], references: [id], onDelete: Restrict)
  durableJob DurableJob   @relation(fields: [durableJobId], references: [id], onDelete: Restrict)
  dispatch   JobDispatch? @relation(fields: [jobDispatchId], references: [id], onDelete: SetNull)

  @@unique([shopId, durableJobId, attemptNumber])
  @@unique([shopId, id])
  @@index([shopId, durableJobId, startedAt])
  @@index([durableJobId, attemptNumber])
}

/// Merchant-domain exactly-once application receipt (F-PR4-01).
model SyncApplicationReceipt {
  id                        String   @id @default(cuid())
  shopId                    String
  applicationKey            String   @db.VarChar(256)
  sourceJobType             String   @db.VarChar(128)
  rootDurableJobId          String
  firstApplyingDurableJobId String
  payloadDigest             String   @db.VarChar(64)
  applicationSchemaVersion  String   @db.VarChar(64)
  appliedAt                 DateTime @default(now())
  resultMetadata            Json?
  createdAt                 DateTime @default(now())

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Restrict)

  @@unique([shopId, applicationKey])
  @@unique([shopId, id])
  @@index([shopId, rootDurableJobId])
  @@index([shopId, appliedAt])
}

model DeadLetter {
  id                 String                    @id @default(cuid())
  shopId             String
  durableJobId       String
  finalAttemptId     String?
  terminalReason     String                    @db.VarChar(128)
  deadLetteredAt     DateTime                  @default(now())
  resolutionState    DeadLetterResolutionState @default(OPEN)
  resolutionReason   String?                   @db.VarChar(512)
  resolvedAt         DateTime?
  replayId           String?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  shop       Shop       @relation(fields: [shopId], references: [id], onDelete: Restrict)
  durableJob DurableJob @relation(fields: [durableJobId], references: [id], onDelete: Restrict)

  @@unique([shopId, id])
  @@index([shopId, resolutionState, deadLetteredAt])
  @@index([durableJobId])
}

/// Partial unique for one OPEN dead letter per job is enforced in migration SQL.
model JobReplay {
  id              String   @id @default(cuid())
  shopId          String
  originalJobId   String
  newJobId        String
  deadLetterId    String?
  replayReason    String   @db.VarChar(512)
  correlationId   String
  causationId     String?
  createdAt       DateTime @default(now())

  shop        Shop       @relation(fields: [shopId], references: [id], onDelete: Restrict)
  originalJob DurableJob @relation("ReplayOriginalJob", fields: [originalJobId], references: [id], onDelete: Restrict)
  newJob      DurableJob @relation("ReplayNewJob", fields: [newJobId], references: [id], onDelete: Restrict)

  @@unique([shopId, id])
  @@unique([shopId, newJobId])
  @@index([shopId, originalJobId, createdAt])
  @@index([originalJobId])
}

model SyncRun {
  id                   String        @id @default(cuid())
  shopId               String
  syncDomain           String        @db.VarChar(64)
  source               String        @db.VarChar(128)
  status               SyncRunStatus @default(PENDING)
  correlationId        String
  startedAt            DateTime?
  completedAt          DateTime?
  failedAt             DateTime?
  cursorBefore         String?       @db.VarChar(512)
  cursorAfter          String?       @db.VarChar(512)
  examinedCount        Int           @default(0)
  appliedCount         Int           @default(0)
  skippedCount         Int           @default(0)
  failedCount          Int           @default(0)
  partialFailure       Boolean       @default(false)
  errorCode            String?       @db.VarChar(64)
  failureSummary       String?       @db.VarChar(512)
  /// PR5-F1 full-sync fence: platform sequence generation committed before Shopify I/O.
  /// Persist as PostgreSQL bigint / Prisma BigInt — never a JavaScript Number.
  fenceGeneration      BigInt?
  fenceAt              DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  shop     Shop        @relation(fields: [shopId], references: [id], onDelete: Restrict)
  issues   DataIssue[]

  @@unique([shopId, id])
  @@index([shopId, syncDomain, createdAt])
  @@index([shopId, status, createdAt])
  @@index([shopId, fenceGeneration])
}

model SyncCursor {
  id          String   @id @default(cuid())
  shopId      String
  syncDomain  String   @db.VarChar(64)
  cursorValue String   @db.VarChar(512)
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Restrict)

  @@unique([shopId, syncDomain])
  @@unique([shopId, id])
}

model ReconciliationRun {
  id             String        @id @default(cuid())
  shopId         String
  domain         String        @db.VarChar(64)
  status         SyncRunStatus @default(PENDING)
  correlationId  String
  startedAt      DateTime?
  completedAt    DateTime?
  failedAt       DateTime?
  examinedCount  Int           @default(0)
  issueCount     Int           @default(0)
  errorCode      String?       @db.VarChar(64)
  failureSummary String?       @db.VarChar(512)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  shop   Shop        @relation(fields: [shopId], references: [id], onDelete: Restrict)
  issues DataIssue[]

  @@unique([shopId, id])
  @@index([shopId, domain, createdAt])
}

model DataIssue {
  id                   String            @id @default(cuid())
  shopId               String
  reconciliationRunId  String?
  syncRunId            String?
  status               DataIssueStatus   @default(OPEN)
  severity             DataIssueSeverity @default(ERROR)
  reasonCode           String            @db.VarChar(64)
  externalResourceType String?           @db.VarChar(64)
  externalResourceId   String?           @db.VarChar(128)
  redactedEvidence     Json?
  detectedAt           DateTime          @default(now())
  resolvedAt           DateTime?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  shop              Shop               @relation(fields: [shopId], references: [id], onDelete: Restrict)
  reconciliationRun ReconciliationRun? @relation(fields: [reconciliationRunId], references: [id], onDelete: SetNull)
  syncRun           SyncRun?           @relation(fields: [syncRunId], references: [id], onDelete: SetNull)

  @@unique([shopId, id])
  @@index([shopId, status, severity, detectedAt])
  @@index([shopId, reasonCode])
}

model SyncHealth {
  id          String         @id @default(cuid())
  shopId      String
  syncDomain  String         @db.VarChar(64)
  state       SyncHealthState @default(NEVER_STARTED)
  detailCode  String?        @db.VarChar(64)
  detailSummary String?      @db.VarChar(512)
  computedAt  DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  createdAt   DateTime       @default(now())

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Restrict)

  @@unique([shopId, syncDomain])
  @@unique([shopId, id])
  @@index([shopId, state])
}

// ─── Phase 1 PR5-F1: canonical catalog / location / inventory facts ──────────
// Shared lineage clocks A/B/C are distinct columns. Do not collapse them.
// New merchant-domain tables: non-null shopId, no legacy shop string,
// no nullable-shopId expand/backfill. RLS/immutability via PR 3 enforcement.

enum CatalogExistenceState {
  LIVE
  ABSENT
}

enum CatalogExistenceKind {
  LIVE_REFETCH
  LIVE_FULL_SYNC_PRESENT
  ABSENT_CONFIRMED_QUERY
}

enum CatalogAttributeFreshnessState {
  ORDERED
  DEGRADED
}

enum CatalogCompatibilityProjectionState {
  HEALTHY
  DEGRADED
}

enum CatalogAbsenceNominationState {
  NONE
  CANDIDATE
  CIRCUIT_BREAKER_HELD
}

enum CatalogObservationLifecycleState {
  ACTIVE
  COMPLETED
  ABANDONED
}

enum CatalogResourceKind {
  Product
  ProductVariant
  InventoryItem
  Location
  InventoryLevel
}

enum CatalogSourceKind {
  FULL_SYNC
  INCREMENTAL_REFETCH
  DELETE_WEBHOOK
  DISCONNECT_WEBHOOK
  RECONCILE
}

enum CatalogDeletionSource {
  WEBHOOK
  CONFIRMED_QUERY
  DISCONNECT
}

enum CatalogUnitCostAccess {
  PRESENT
  NULL
  OMITTED_NO_PERMISSION
  QUERY_ERROR_ISOLATED
}

enum ShopifyProductStatus {
  ACTIVE
  ARCHIVED
  DRAFT
  UNLISTED
}

model ShopifyProductFact {
  id                           String                              @id @default(cuid())
  shopId                       String
  shopifyGid                   String                              @db.VarChar(256)
  title                        String
  handle                       String
  vendor                       String?
  productType                  String?
  tags                         String[]
  status                       ShopifyProductStatus
  featuredMediaUrl             String?
  shopifyCreatedAt             DateTime?
  shopifyUpdatedAt             DateTime?
  existenceState               CatalogExistenceState
  existenceKind                CatalogExistenceKind
  existenceObservedAt          DateTime
  existenceRequestGen          BigInt?
  existenceResponseGen         BigInt?
  signalReceivedAt             DateTime?
  lastSignalTopic              String?                             @db.VarChar(128)
  lastSignalDeliveryId         String?                             @db.VarChar(128)
  lastSignalTriggeredAt        DateTime?
  lastSeenFullSyncRunId        String?
  attributeRequestGen          BigInt?
  attributeResponseGen         BigInt?
  attributeFreshnessState      CatalogAttributeFreshnessState      @default(ORDERED)
  compatibilityProjectionState CatalogCompatibilityProjectionState @default(HEALTHY)
  existenceDiagnosticState     String?                             @db.VarChar(128)
  absenceNominationState       CatalogAbsenceNominationState       @default(NONE)
  absenceCandidateEpochId      String?
  absenceCandidateGeneration   BigInt?
  ingestBatchId                String?
  lastSeenAt                   DateTime?
  lastRefreshedAt              DateTime?
  appliedAt                    DateTime?
  lastSyncRunId                String?
  lastDurableJobId             String?
  sourceKind                   CatalogSourceKind
  deletedAt                    DateTime?
  deletionSource               CatalogDeletionSource?
  shopifyLegacyResourceId      String?                             @db.VarChar(64)
  createdAt                    DateTime                            @default(now())
  updatedAt                    DateTime                            @updatedAt

  shop                   Shop                                 @relation(fields: [shopId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  variants               ShopifyVariantFact[]
  collectionMemberships  ShopifyProductCollectionMembership[]

  @@unique([shopId, id])
  @@unique([shopId, shopifyGid])
  @@index([shopId, existenceState])
  @@index([shopId, lastSeenFullSyncRunId])
  @@index([shopId, handle])
  @@index([shopId, vendor])
}

model ShopifyProductCollectionMembership {
  id                      String   @id @default(cuid())
  shopId                  String
  shopifyProductGid       String   @db.VarChar(256)
  shopifyCollectionGid    String   @db.VarChar(256)
  collectionTitleSnapshot String
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  shop    Shop               @relation(fields: [shopId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  product ShopifyProductFact @relation(fields: [shopId, shopifyProductGid], references: [shopId, shopifyGid], onDelete: Restrict, onUpdate: NoAction)

  @@unique([shopId, id])
  @@unique([shopId, shopifyProductGid, shopifyCollectionGid])
  @@index([shopId, shopifyCollectionGid])
}

model ShopifyVariantFact {
  id                           String                              @id @default(cuid())
  shopId                       String
  shopifyGid                   String                              @db.VarChar(256)
  shopifyProductGid            String                              @db.VarChar(256)
  title                        String
  displayName                  String?
  selectedOptions              Json
  sku                          String?
  barcode                      String?
  priceAmount                  Decimal                             @db.Decimal(20, 6)
  compareAtPriceAmount         Decimal?                            @db.Decimal(20, 6)
  currencyCode                 String                              @db.VarChar(8)
  position                     Int?
  shopifyCreatedAt             DateTime?
  shopifyUpdatedAt             DateTime?
  existenceState               CatalogExistenceState
  existenceKind                CatalogExistenceKind
  existenceObservedAt          DateTime
  existenceRequestGen          BigInt?
  existenceResponseGen         BigInt?
  signalReceivedAt             DateTime?
  lastSignalTopic              String?                             @db.VarChar(128)
  lastSignalDeliveryId         String?                             @db.VarChar(128)
  lastSignalTriggeredAt        DateTime?
  lastSeenFullSyncRunId        String?
  attributeRequestGen          BigInt?
  attributeResponseGen         BigInt?
  attributeFreshnessState      CatalogAttributeFreshnessState      @default(ORDERED)
  compatibilityProjectionState CatalogCompatibilityProjectionState @default(HEALTHY)
  existenceDiagnosticState     String?                             @db.VarChar(128)
  absenceNominationState       CatalogAbsenceNominationState       @default(NONE)
  absenceCandidateEpochId      String?
  absenceCandidateGeneration   BigInt?
  ingestBatchId                String?
  lastSeenAt                   DateTime?
  lastRefreshedAt              DateTime?
  appliedAt                    DateTime?
  lastSyncRunId                String?
  lastDurableJobId             String?
  sourceKind                   CatalogSourceKind
  deletedAt                    DateTime?
  deletionSource               CatalogDeletionSource?
  shopifyLegacyResourceId      String?                             @db.VarChar(64)
  createdAt                    DateTime                            @default(now())
  updatedAt                    DateTime                            @updatedAt

  shop    Shop               @relation(fields: [shopId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  product ShopifyProductFact @relation(fields: [shopId, shopifyProductGid], references: [shopId, shopifyGid], onDelete: Restrict, onUpdate: NoAction)
  inventoryItems ShopifyInventoryItemFact[]

  @@unique([shopId, id])
  @@unique([shopId, shopifyGid])
  @@index([shopId, shopifyProductGid])
  @@index([shopId, existenceState])
  @@index([shopId, lastSeenFullSyncRunId])
  @@index([shopId, sku])
  @@index([shopId, barcode])
}

model ShopifyInventoryItemFact {

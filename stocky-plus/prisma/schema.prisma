model CatalogObservationInFlight {
  id                     String                            @id @default(cuid())
  shopId                 String
  resourceKind           CatalogResourceKind
  shopifyGid             String?                           @db.VarChar(256)
  inventoryItemGid       String?                           @db.VarChar(256)
  locationGid            String?                           @db.VarChar(256)
  observationRequestGen  BigInt
  observationResponseGen BigInt?
  /// Application supplies only a validated finite duration. PostgreSQL
  /// overwrites leaseExpiresAt with clock_timestamp() + duration on INSERT.
  leaseDurationMs        Int
  leaseExpiresAt         DateTime                            @db.Timestamptz(3)
  lifecycleState         CatalogObservationLifecycleState
  durableJobId           String?
  jobAttemptId           String?
  correlationId          String?
  createdAt              DateTime                          @default(now())
  updatedAt              DateTime                          @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([shopId, id])
  @@index([shopId, resourceKind, shopifyGid, lifecycleState])
  @@index([shopId, resourceKind, inventoryItemGid, locationGid, lifecycleState])
  @@index([shopId, leaseExpiresAt, lifecycleState])
  @@index([shopId, observationRequestGen])
}

  shopifyLegacyResourceId      String?                             @db.VarChar(64)
  createdAt                    DateTime                            @default(now())
  updatedAt                    DateTime                            @updatedAt

  shop            Shop                         @relation(fields: [shopId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  variant         ShopifyVariantFact?          @relation(fields: [shopId, shopifyVariantGid], references: [shopId, shopifyGid], onDelete: NoAction, onUpdate: NoAction)
  inventoryLevels ShopifyInventoryLevelFact[]

  @@unique([shopId, id])
  @@unique([shopId, shopifyGid])
  @@index([shopId, shopifyVariantGid])
  @@index([shopId, existenceState])
  @@index([shopId, lastSeenFullSyncRunId])

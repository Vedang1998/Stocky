{
  "name": "stocky-plus",
  "private": true,
  "scripts": {
    "build": "react-router build",
    "dev": "shopify app dev",
    "config:link": "shopify app config link",
    "generate": "shopify app generate",
    "deploy": "shopify app deploy",
    "config:use": "shopify app config use",
    "env": "shopify app env",
    "start": "react-router-serve ./build/server/index.js",
    "docker-start": "npm run setup && npm run start",
    "setup": "prisma generate && prisma migrate deploy",
    "worker": "tsx app/jobs/workers/index.ts",
    "db:migrate": "tsx scripts/tenant-enforcement/guard-prisma-destructive.ts migrate",
    "db:push": "tsx scripts/tenant-enforcement/guard-prisma-destructive.ts push",
    "db:seed": "tsx prisma/seed.ts",
    "lint": "eslint --ignore-path .gitignore --cache --cache-location ./node_modules/.cache/eslint .",
    "shopify": "shopify",
    "prisma": "prisma",
    "graphql-codegen": "graphql-codegen",
    "vite": "vite",
    "typecheck": "react-router typegen && tsc --noEmit",
    "test": "vitest run",
    "test:migrations": "vitest run --config vitest.migrations.config.ts",
    "test:migrations-name-filter-probes": "vitest run --config vitest.migrations-name-filter-probes.config.ts",
    "test:vitest-reporters": "vitest run --config vitest.reporters.config.ts",
    "test:subject-memory": "NODE_OPTIONS=--max-old-space-size=256 vitest run --config vitest.migrations.config.ts scripts/tenant-backfill/tests/subject-memory.migration.test.ts",
    "tenant:diagnose": "tsx scripts/tenant-backfill/diagnose.ts",
    "tenant:backfill": "tsx scripts/tenant-backfill/cli.ts",
    "tenant:backfill:status": "tsx scripts/tenant-backfill/status.ts",
    "tenant:indexes:plan": "tsx scripts/tenant-indexes/cli.ts plan",
    "tenant:indexes:apply": "tsx scripts/tenant-indexes/cli.ts apply",
    "tenant:indexes:verify": "tsx scripts/tenant-indexes/cli.ts verify",
    "tenant:schema:drift": "tsx scripts/tenant-indexes/drift.ts",
    "tenant:access:audit": "tsx scripts/tenant-access/audit.ts",
    "tenant:access:inventory": "tsx scripts/tenant-access/inventory.ts",
    "tenant:access:inventory:check": "tsx scripts/tenant-access/inventory-check.ts",
    "sync:inventory": "tsx scripts/sync-control-plane/inventory.ts",
    "sync:inventory:check": "tsx scripts/sync-control-plane/inventory-check.ts",
    "sync:roles:provision": "tsx scripts/sync-control-plane/cli.ts provision",
    "sync:roles:verify": "tsx scripts/sync-control-plane/cli.ts verify",
    "sync:claim-indexes:plan": "tsx scripts/sync-control-plane/claim-indexes-cli.ts plan",
    "sync:claim-indexes:apply": "tsx scripts/sync-control-plane/claim-indexes-cli.ts apply",
    "sync:claim-indexes:verify": "tsx scripts/sync-control-plane/claim-indexes-cli.ts verify",
    "test:sync-integration": "vitest run --config vitest.sync-integration.config.ts",
    "test:sync-exactly-once": "vitest run --config vitest.sync-integration.config.ts app/sync/__tests__/sync-exactly-once.test.ts app/sync/__tests__/sync-d046-worker-finalize.test.ts",
    "test:sync-dispatch-recovery": "vitest run --config vitest.sync-integration.config.ts app/sync/__tests__/sync-dispatch-recovery.test.ts",
    "test:sync-uninstall": "vitest run --config vitest.sync-integration.config.ts app/sync/__tests__/sync-uninstall.test.ts",
    "test:sync-attempt-recovery": "vitest run --config vitest.sync-integration.config.ts app/sync/__tests__/sync-attempt-recovery.test.ts",
    "test:sync-envelope-fail-closed": "vitest run --config vitest.sync-integration.config.ts app/sync/__tests__/sync-envelope-fail-closed.test.ts",
    "test:sync-final-correction": "vitest run --config vitest.sync-integration.config.ts app/sync/__tests__/sync-final-correction.test.ts",
    "test:sync-role-isolation": "vitest run --config vitest.sync-integration.config.ts scripts/sync-control-plane/tests/sync-role-isolation.test.ts",
    "test:sync-inventory-audit": "vitest run --config vitest.sync-integration.config.ts scripts/sync-control-plane/tests/sync-inventory-audit.test.ts",
    "test:sync-performance": "vitest run --config vitest.sync-integration.config.ts app/sync/__tests__/sync-performance.test.ts app/sync/__tests__/eligible-claim-plan.test.ts app/sync/__tests__/dispatch-ready-shop.test.ts app/sync/__tests__/d049-readiness-corrections.test.ts app/sync/__tests__/d050-corrections.test.ts",
    "tenant:enforcement:inventory": "tsx scripts/tenant-enforcement/inventory.ts",
    "tenant:enforcement:inventory:check": "tsx scripts/tenant-enforcement/inventory-check.ts",
    "tenant:enforcement:preflight": "tsx scripts/tenant-enforcement/cli.ts preflight",
    "tenant:enforcement:plan": "tsx scripts/tenant-enforcement/cli.ts plan",
    "tenant:enforcement:apply": "tsx scripts/tenant-enforcement/cli.ts apply",
    "tenant:enforcement:verify": "tsx scripts/tenant-enforcement/cli.ts verify",
    "tenant:enforcement:drift": "tsx scripts/tenant-enforcement/cli.ts drift",
    "tenant:roles:provision": "tsx scripts/tenant-enforcement/cli.ts roles-provision",
    "tenant:roles:verify": "tsx scripts/tenant-enforcement/cli.ts roles-verify",
    "tenant:rls:verify": "tsx scripts/tenant-enforcement/cli.ts rls-verify",
    "tenant:immutability:verify": "tsx scripts/tenant-enforcement/cli.ts immutability-verify",
    "test:tenant-access": "vitest run --config vitest.tenant-access.config.ts",
    "test:db-isolation": "vitest run --config vitest.db-isolation.config.ts",
    "test:enforcement-definition-drift": "vitest run --config vitest.migrations.config.ts scripts/tenant-enforcement/tests/definition-drift.test.ts",
    "test:enforcement-role-membership": "vitest run --config vitest.migrations.config.ts scripts/tenant-enforcement/tests/role-membership.test.ts",
    "test:enforcement-connected-identity": "vitest run --config vitest.migrations.config.ts scripts/tenant-enforcement/tests/connected-identity.test.ts",
    "test:enforcement-partial-apply": "vitest run --config vitest.migrations.config.ts scripts/tenant-enforcement/tests/partial-apply-recovery.test.ts",
    "test:enforcement-populated": "vitest run --config vitest.migrations.config.ts scripts/tenant-enforcement/tests/populated-concurrency.test.ts"
  },
  "type": "module",
  "packageManager": "npm@11.5.2",
  "engines": {
    "node": ">=20.19 <22 || >=22.12",
    "npm": "11.5.2"
  },
  "dependencies": {
    "@prisma/client": "^6.16.3",
    "@react-pdf/renderer": "^4.3.0",
    "@react-router/dev": "^7.12.0",
    "@react-router/fs-routes": "^7.12.0",
    "@react-router/node": "^7.12.0",
    "@react-router/serve": "^7.12.0",
    "@shopify/app-bridge-react": "^4.2.4",
    "@shopify/polaris": "^13.9.5",
    "@shopify/polaris-icons": "^9.3.1",
    "@shopify/shopify-app-react-router": "^1.1.0",
    "@shopify/shopify-app-session-storage-prisma": "^9.0.0",
    "bullmq": "^5.34.8",
    "ioredis": "^5.6.0",
    "isbot": "^5.1.31",
    "pg": "^8.16.3",
    "prisma": "^6.16.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^7.12.0",
    "vite-tsconfig-paths": "^6.0.4"
  },
  "devDependencies": {
    "@shopify/api-codegen-preset": "^2.0.0",
    "@shopify/polaris-types": "1.0.1",
    "@types/eslint": "^9.6.1",
    "@types/node": "^25.5.2",
    "@types/pg": "^8.15.4",
    "@types/react": "^18.3.25",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.57.1",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "graphql-config": "^5.1.1",
    "prettier": "^3.6.2",
    "tsx": "^4.19.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^3.0.9"
  },
  "workspaces": {
    "packages": [
      "extensions/*"
    ]
  },
  "trustedDependencies": [
    "@shopify/plugin-cloudflare"
  ],
  "overrides": {
    "p-map": "^4.0.0"
  }
}

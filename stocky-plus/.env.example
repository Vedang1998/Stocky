# Shopify (set by `shopify app dev` or Partner Dashboard)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SCOPES=read_products,write_products,read_inventory,write_inventory,read_orders,read_all_orders,read_locations
SHOPIFY_APP_URL=
# App handle from the Partner Dashboard (the slug in the app's admin URL).
# Required for the Billing page to open Shopify's hosted plan selection page.
SHOPIFY_APP_HANDLE=

# Partner API, where Shopify App Pricing reports each shop's subscription.
# Set all three or none. With none set, subscription status is read from the
# Admin API instead, which Shopify does not document for App Pricing.
# SHOPIFY_PARTNER_ORG_ID — the number in the Partner Dashboard URL.
# SHOPIFY_PARTNER_API_ACCESS_TOKEN — token of a Partner API client with the
#   Manage apps permission. A secret: never commit it.
# SHOPIFY_APP_GID — gid://shopify/App/<the app's numeric id>.
# SHOPIFY_PARTNER_ORG_ID=
# SHOPIFY_PARTNER_API_ACCESS_TOKEN=
# SHOPIFY_APP_GID=

# PostgreSQL (matches docker-compose.yml)
DATABASE_URL=postgresql://stocky:stocky@localhost:5432/stocky_plus

# PR 3 role separation (do not commit real passwords)
# DATABASE_MIGRATION_URL / TENANT_MAINTENANCE_DATABASE_URL — migration owner (direct, non-pooler)
# DATABASE_RUNTIME_URL — restricted runtime role (RLS subject)
# STOCKY_REQUIRE_RUNTIME_DB_URL=1 — fail closed if runtime URL missing (production-like)
# TENANT_MAINTENANCE_DATABASE_URL=
# DATABASE_MIGRATION_URL=
# DATABASE_RUNTIME_URL=
# STOCKY_RUNTIME_ROLE=stocky_runtime
# STOCKY_MIGRATION_ROLE=stocky_migration
# STOCKY_REQUIRE_RUNTIME_DB_URL=0

# Sync control plane. The worker does not start without both; the web server
# needs the first to record webhooks.
# DATABASE_CONTROL_PLANE_URL — connection as the stocky_control_plane role.
# STOCKY_DISPATCHER_PROCESS_COUNT — how many worker processes run the
# dispatcher (1 for a single worker).
# DATABASE_CONTROL_PLANE_URL=
# STOCKY_DISPATCHER_PROCESS_COUNT=1

# Redis (BullMQ webhook queue)
REDIS_URL=redis://localhost:6379

# Tenant job envelope HMAC (PR 2 transport integrity).
# Require ≥32 bytes after decoding/normalization. Do NOT reuse SHOPIFY_API_SECRET.
# Generate locally, e.g.: openssl rand -base64 48
TENANT_JOB_ENVELOPE_SECRET=

# Encryption key for Shopify access and refresh tokens in the Session table.
# 32 random bytes in base64: openssl rand -base64 32
# Required when NODE_ENV=production; without it elsewhere tokens are stored
# as issued. After setting it, and after putting a new key in front of the
# old one (comma-separated) to rotate, run `npm run session-tokens:reencrypt`;
# the old key can be removed once that reports nothing rewritten.
SESSION_TOKEN_ENCRYPTION_KEY=

# Local tool versions (lockfile requires exact npm):
# Node: compatible with package.json engines.node
# npm: exactly 11.5.2

# Forecasting defaults (current repo behavior — NOT Stocky Last X parity)
DEFAULT_LOOKBACK_DAYS=30
DEFAULT_TARGET_DAYS_OF_STOCK=14
DEFAULT_SAFETY_STOCK=0

# Phase 0 inventory-write kill switches (default OFF)
# Enable only on approved development stores after release gates pass.
FEATURE_STOCKTAKE_INVENTORY_WRITES=false
FEATURE_ADJUSTMENT_WRITES=false
FEATURE_RECEIPT_WRITES=false
FEATURE_COST_SYNC=false
FEATURE_TRANSFER_WRITES=false
# PR5 absence tombstones remain DEFAULT OFF through F3.
FEATURE_PR5_ABSENCE_TOMBSTONE=false

# Development-only subscription bypass for Buying Table (never enable in production)
ALLOW_DEV_SUBSCRIPTION_ACTIVATE=false

# Privacy compliance (worker).
# Days an uninstalled shop's data is kept before it is erased even when
# Shopify's shop/redact webhook never arrives. Whole number, 1 to 365.
PRIVACY_UNINSTALLED_RETENTION_DAYS=30
# How often the worker looks for erasure work, in milliseconds. 0 turns it off.
STOCKY_PRIVACY_INTERVAL_MS=60000
